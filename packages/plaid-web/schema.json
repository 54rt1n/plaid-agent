{
  "openapi": "3.1.0",
  "info": {
    "title": "Plaid Agent Link",
    "version": "0.1.0"
  },
  "paths": {
    "/api/session": {
      "post": {
        "summary": "Login",
        "operationId": "login_api_session_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Login"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Logout",
        "operationId": "logout_api_session_delete",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        }
      }
    },
    "/api/status": {
      "get": {
        "summary": "Status",
        "operationId": "status_api_status_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          }
        }
      }
    },
    "/api/link/sessions": {
      "post": {
        "summary": "Start",
        "operationId": "start_api_link_sessions_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Start"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LinkSession"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/link/complete": {
      "post": {
        "summary": "Complete",
        "operationId": "complete_api_link_complete_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Finish"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Connection"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/setup/finish": {
      "post": {
        "summary": "Finish Setup",
        "operationId": "finish_setup_api_setup_finish_post",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        }
      }
    },
    "/oauth-return": {
      "get": {
        "summary": "Website",
        "operationId": "website_oauth_return_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/": {
      "get": {
        "summary": "Website",
        "operationId": "website__get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Connection": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "institution": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Institution"
          },
          "products": {
            "items": {
              "type": "string",
              "enum": [
                "transactions",
                "investments",
                "liabilities"
              ]
            },
            "type": "array",
            "title": "Products"
          },
          "connected_at": {
            "type": "string",
            "format": "date-time",
            "title": "Connected At"
          },
          "last_transaction_sync": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Transaction Sync"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "products",
          "connected_at"
        ],
        "title": "Connection"
      },
      "ConnectionReadiness": {
        "properties": {
          "connection_id": {
            "type": "string",
            "title": "Connection Id"
          },
          "cached_accounts": {
            "type": "integer",
            "title": "Cached Accounts"
          },
          "cached_posted_transactions": {
            "type": "integer",
            "title": "Cached Posted Transactions"
          },
          "transaction_cache": {
            "type": "string",
            "enum": [
              "not_enabled",
              "not_synced",
              "cached_records",
              "no_cached_records"
            ],
            "title": "Transaction Cache"
          },
          "history_loading": {
            "type": "string",
            "const": "unknown",
            "title": "History Loading",
            "default": "unknown"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "connection_id",
          "cached_accounts",
          "cached_posted_transactions",
          "transaction_cache"
        ],
        "title": "ConnectionReadiness"
      },
      "Coverage": {
        "properties": {
          "records": {
            "items": {
              "$ref": "#/components/schemas/CoverageRow"
            },
            "type": "array",
            "title": "Records"
          },
          "group_by": {
            "type": "string",
            "enum": [
              "connection",
              "account"
            ],
            "title": "Group By"
          },
          "include_pending": {
            "type": "boolean",
            "title": "Include Pending"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "offset": {
            "type": "integer",
            "title": "Offset"
          },
          "next_offset": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Offset"
          },
          "meaning": {
            "type": "string",
            "title": "Meaning",
            "default": "Stored bank transaction coverage; not proof of complete institution history."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "records",
          "group_by",
          "include_pending",
          "total",
          "offset",
          "next_offset"
        ],
        "title": "Coverage"
      },
      "CoverageRow": {
        "properties": {
          "connection_id": {
            "type": "string",
            "title": "Connection Id"
          },
          "institution": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Institution"
          },
          "account_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Account Id"
          },
          "account_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Account Name"
          },
          "count": {
            "type": "integer",
            "title": "Count"
          },
          "earliest_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Earliest Date"
          },
          "latest_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Latest Date"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "connection_id",
          "count"
        ],
        "title": "CoverageRow"
      },
      "Finish": {
        "properties": {
          "session_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Session Id"
          },
          "public_token": {
            "anyOf": [
              {
                "type": "string",
                "format": "password",
                "writeOnly": true
              },
              {
                "type": "null"
              }
            ],
            "title": "Public Token"
          },
          "institution_name": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "title": "Institution Name"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "session_id"
        ],
        "title": "Finish"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LinkSession": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "link_token": {
            "type": "string",
            "title": "Link Token"
          },
          "expiration": {
            "type": "string",
            "format": "date-time",
            "title": "Expiration"
          },
          "mode": {
            "type": "string",
            "enum": [
              "connect",
              "update"
            ],
            "title": "Mode"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "link_token",
          "expiration",
          "mode"
        ],
        "title": "LinkSession"
      },
      "Login": {
        "properties": {
          "token": {
            "type": "string",
            "format": "password",
            "title": "Token",
            "writeOnly": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "token"
        ],
        "title": "Login"
      },
      "Start": {
        "properties": {
          "connection_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Connection Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Start"
      },
      "Status": {
        "properties": {
          "environment": {
            "type": "string",
            "enum": [
              "sandbox",
              "production"
            ],
            "title": "Environment"
          },
          "initialized": {
            "type": "boolean",
            "title": "Initialized"
          },
          "products": {
            "items": {
              "type": "string",
              "enum": [
                "transactions",
                "investments",
                "liabilities"
              ]
            },
            "type": "array",
            "title": "Products"
          },
          "connections": {
            "items": {
              "$ref": "#/components/schemas/Connection"
            },
            "type": "array",
            "title": "Connections"
          },
          "data_dir": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Data Dir"
          },
          "readiness": {
            "items": {
              "$ref": "#/components/schemas/ConnectionReadiness"
            },
            "type": "array",
            "title": "Readiness"
          },
          "coverage": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Coverage"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "environment",
          "initialized",
          "products",
          "connections"
        ],
        "title": "Status"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
